@model IEnumerable<MomiaTrainSync.Models.Usuario>

@{
    ViewData["Title"] = "Mis Atletas";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .trainer-title {
        font-weight: 700;
        color: #264653;
        margin-bottom: 2rem;
    }

    .filter-row input, .filter-row select {
        width: 100%;
        padding: 3px;
        border-radius: 0.3rem;
        border: 1px solid #ccc;
        font-size: 0.9rem;
    }
</style>

<div class="container mt-4 px-3 px-md-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="trainer-title">Mis Atletas</h2>
    </div>

    <div class="card shadow-sm rounded-3">
        <div class="table-responsive p-3">
            <table id="tablaAtletas" class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Objetivo</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                    <tr class="filter-row">
                        <th><input type="text" placeholder="Filtrar por nombre" /></th>
                        <th><input type="text" placeholder="Filtrar por objetivo" /></th>
                        <th>
                            <select id="filtroEstado">
                                <option value="">Todos</option>
                                <option value="Activo">Activo</option>
                                <option value="Inactivo">Inactivo</option>
                            </select>
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var atleta in Model)
                    {
                        <tr data-estado="@atleta.Estado">
                            <td>@atleta.Nombre</td>
                            <td>@(string.IsNullOrEmpty(atleta.ObjetivoTexto) ? "Sin objetivo" : atleta.ObjetivoTexto)</td>
                            <td>
                                <span class="badge @(atleta.Estado == "Activo" ? "bg-success" : "bg-secondary")">
                                    @atleta.Estado
                                </span>
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("Detalle", "Entrenador", new { id = atleta.Id })" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-eye"></i> Ver
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#tablaAtletas').DataTable({
                orderCellsTop: true,
                fixedHeader: true,
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros por página",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ atletas",
                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    },
                    zeroRecords: "No se encontraron resultados",
                    infoEmpty: "Mostrando 0 a 0 de 0 atletas",
                    infoFiltered: "(filtrado de _MAX_ atletas totales)"
                }
            });

            $('#tablaAtletas thead tr.filter-row input').on('keyup change', function () {
                var colIndex = $(this).parent().index();
                table.column(colIndex).search(this.value).draw();
            });

            $('#filtroEstado').on('change', function () {
                var filtro = $(this).val();
                table.column(2).search(filtro).draw();
            });
        });
    </script>
}
