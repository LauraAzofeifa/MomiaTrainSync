@model MomiaTrainSync.Models.Usuario

@{
    ViewData["Title"] = "Detalle del Atleta";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var planes = ViewBag.Planes as List<MomiaTrainSync.Models.PlanEntrenamiento>;
}

<style>
    .profile-card {
        max-width: 850px;
        margin: auto;
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
        padding: 2rem;
    }

    .profile-header {
        text-align: center;
        margin-bottom: 2rem;
    }

        .profile-header h2 {
            font-weight: 700;
            color: #264653;
        }

    .profile-info .row {
        margin-bottom: 1rem;
    }

    .profile-label {
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

    .profile-value {
        font-size: 1rem;
        color: #264653;
    }

    .table-section {
        margin-top: 3rem;
    }

    .table-title {
        font-weight: 700;
        color: #264653;
        margin-bottom: 1rem;
    }

    .filter-row input, .filter-row select {
        width: 100%;
        padding: 3px;
        border-radius: 0.3rem;
        border: 1px solid #ccc;
        font-size: 0.9rem;
    }

    .btn-back {
        background-color: #264653;
        border: none;
        border-radius: 0.5rem;
    }

        .btn-back:hover {
            background-color: #1e3a4a;
        }
</style>

<div class="container-fluid px-3 px-md-4 mt-4">
    <div class="profile-card">
        <div class="profile-header">
            <h2><i class="fas fa-user-circle me-2"></i>Detalle del Atleta</h2>
        </div>

        <div class="profile-info">
            <div class="row">
                <div class="col-md-4 profile-label">Nombre</div>
                <div class="col-md-8 profile-value">@Model.Nombre</div>
            </div>

            <div class="row">
                <div class="col-md-4 profile-label">Correo</div>
                <div class="col-md-8 profile-value">@Model.Correo</div>
            </div>

            <div class="row">
                <div class="col-md-4 profile-label">Estado</div>
                <div class="col-md-8">
                    <span class="badge @(Model.Estado == "Activo" ? "bg-success" : "bg-secondary")">
                        @Model.Estado
                    </span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 profile-label">Fecha de Registro</div>
                <div class="col-md-8 profile-value">@Model.FechaRegistro.ToString("yyyy-MM-dd")</div>
            </div>

            <div class="row">
                <div class="col-md-4 profile-label">Objetivo Personal</div>
                <div class="col-md-8 profile-value">
                    @if (!string.IsNullOrWhiteSpace(Model.ObjetivoTexto))
                    {
                        @Model.ObjetivoTexto
                    }
                    else
                    {
                        <span class="text-muted">Sin objetivo asignado</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="table-section">
        <h3 class="table-title"><i class="fas fa-dumbbell me-2"></i>Planes de Entrenamiento</h3>

        <table id="tablaPlanes" class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Fecha</th>
                    <th>Creador</th>
                    <th>Objetivo</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
                <tr class="filter-row">
                    <th><input type="text" placeholder="AAAA-MM-DD" /></th>
                    <th><input type="text" placeholder="Filtrar por creador" /></th>
                    <th><input type="text" placeholder="Filtrar por objetivo" /></th>
                    <th>
                        <select>
                            <option value="">Todos</option>
                            <option value="Activo">Activo</option>
                            <option value="Inactivo">Inactivo</option>
                        </select>
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (planes?.Any() == true)
                {
                    foreach (var plan in planes)
                    {
                        <tr data-estado="@(plan.Estado ? "Activo" : "Inactivo")">
                            <td>@plan.FechaCreacion.ToString("yyyy-MM-dd")</td>
                            <td>@plan.Creador?.Nombre</td>
                            <td>@plan.Objetivo</td>
                            <td>
                                <span class="badge @(plan.Estado ? "bg-success" : "bg-danger")">
                                    @(plan.Estado ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("Details", "PlanEntrenamiento", new { id = plan.Id })"
                                   class="btn btn-outline-primary btn-sm" title="Ver">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">Este atleta no tiene planes aún.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end mt-3">
        <a href="@Url.Action("Atleta", "Entrenador")" class="btn btn-back text-white">
            <i class="fas fa-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#tablaPlanes').DataTable({
                orderCellsTop: true,
                fixedHeader: true,
                order: [[0, 'desc']],
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros por página",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ planes",
                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    },
                    zeroRecords: "No se encontraron resultados",
                    infoEmpty: "Mostrando 0 a 0 de 0 planes",
                    infoFiltered: "(filtrado de _MAX_ planes totales)"
                }
            });

            $('#tablaPlanes thead tr.filter-row input, #tablaPlanes thead tr.filter-row select').on('keyup change', function () {
                var colIndex = $(this).parent().index();
                table.column(colIndex).search(this.value).draw();
            });
        });
    </script>
}
