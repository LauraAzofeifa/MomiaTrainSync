@model IEnumerable<MomiaTrainSync.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .admin-title {
        font-weight: 700;
        color: #264653;
        margin-bottom: 1.5rem;
    }

    .btn-agregar {
        background-color: #2a9d8f;
        color: white;
        border: none;
        border-radius: 0.5rem;
    }

        .btn-agregar:hover {
            background-color: #21867a;
        }

    .table thead {
        background-color: #e0f0f0;
        color: #264653;
        font-weight: 600;
    }

    .table td, .table th {
        vertical-align: middle;
    }

    .filter-row input {
        width: 100%;
        padding: 3px;
        border-radius: 0.3rem;
        border: 1px solid #ccc;
        font-size: 0.9rem;
    }

    .btn-action {
        margin-right: 0.4rem;
    }

    .badge {
        font-size: 0.85rem;
    }

    .dataTables_filter {
        display: none !important;
    }
</style>

<div class="container-fluid px-3 px-md-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="admin-title">Gestión de Usuarios</h2>
        <a href="@Url.Action("CrearUsuario", "Admin")" class="btn btn-agregar">
            <i class="fas fa-user-plus me-2"></i>Agregar Usuario
        </a>
    </div>  

    <div class="table-responsive">
        <table id="tablaUsuarios" class="table table-bordered table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Fecha Ingreso</th>
                    <th>Entrenador</th>
                    <th class="text-center">Acciones</th>
                </tr>
                <tr class="filter-row">
                    <th></th>
                    <th><input type="text" placeholder="Filtrar por nombre" /></th>
                    <th><input type="text" placeholder="Filtrar por correo" /></th>
                    <th><input type="text" placeholder="Filtrar por rol" /></th>
                    <th><input type="text" placeholder="Activo / Inactivo" /></th>
                    <th><input type="text" placeholder="Filtrar por fecha" /></th>
                    <th><input type="text" placeholder="Filtrar por entrenador" /></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model)
                {
                    <tr>
                        <td>@usuario.Id</td>
                        <td>@usuario.Nombre</td>
                        <td>@usuario.Correo</td>
                        <td>@usuario.Rol</td>
                        <td class="text-center">
                            <span class="badge @(usuario.Estado == "Activo" ? "bg-success" : "bg-danger")">
                                @usuario.Estado
                            </span>
                        </td>
                        <td>@usuario.FechaRegistro.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (usuario.Rol == "Atleta")
                            {
                                @(usuario.Entrenador?.Nombre ?? "Sin asignar")
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>
                        <td class="text-center">
                            <a href="/Admin/EditarUsuario/@usuario.Id" class="btn btn-sm btn-primary btn-action" title="Editar">
                                <i class="fas fa-edit"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#tablaUsuarios').DataTable({
                orderCellsTop: true,
                fixedHeader: true,
                order: [[5, 'desc']],
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros por página",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ usuarios",
                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    },
                    zeroRecords: "No se encontraron resultados",
                    infoEmpty: "Mostrando 0 a 0 de 0 usuarios",
                    infoFiltered: "(filtrado de _MAX_ usuarios totales)"
                }
            });

            $('#tablaUsuarios thead tr.filter-row input').on('keyup change', function () {
                var colIndex = $(this).parent().index();
                table.column(colIndex).search(this.value).draw();
            });
        });
    </script>
}
