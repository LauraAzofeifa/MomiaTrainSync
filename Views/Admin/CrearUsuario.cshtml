@model MomiaTrainSync.Models.Usuario

@{
    ViewData["Title"] = "Agregar Usuario";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-3 px-md-4">
    <div class="form-container mt-4">
        <h2>Agregar Nuevo Usuario</h2>

        
        <form asp-action="CrearUsuario" asp-controller="Admin" method="post">
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Laura Azofeifa" />
                <span asp-validation-for="Nombre" class="form-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" placeholder="Ej: laura@example.com" />
                <span asp-validation-for="Correo" class="form-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Rol" class="form-label"></label>
                <select asp-for="Rol" class="form-select">
                    <option selected disabled>Seleccione un rol</option>
                    <option value="Administrador">Administrador</option>
                    <option value="Entrenador">Entrenador</option>
                    <option value="Atleta">Atleta</option>
                </select>
                <span asp-validation-for="Rol" class="form-error"></span>

                <div class="note mt-2">
                    <b>La contraseña se generará automáticamente y será enviada al correo proporcionado.</b>
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Usuarios" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-success">Guardar Usuario</button>
            </div>
        </form>
    </div>
</div>
