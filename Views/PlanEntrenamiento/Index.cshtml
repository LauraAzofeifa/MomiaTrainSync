@using Microsoft.AspNetCore.Http
@model IEnumerable<MomiaTrainSync.Models.PlanEntrenamiento>

@{
    ViewData["Title"] = "Planes de Entrenamiento";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var currentUserId = int.TryParse(Context.Session.GetString("UsuarioId"), out var id) ? id : 0;
    var currentUserRole = Context.Session.GetString("UsuarioRol");
}

<style>
    .trainer-title {
        font-weight: 700;
        color: #264653;
        margin-bottom: 2rem;
    }

    .table thead {
        background-color: #e0f0f0;
        color: #264653;
        font-weight: 600;
    }

    .filter-row input, .filter-row select {
        width: 100%;
        padding: 3px;
        border-radius: 0.3rem;
        border: 1px solid #ccc;
        font-size: 0.9rem;
    }

    .badge {
        font-size: 0.85rem;
    }

    .btn-action {
        margin-right: 4px;
    }
</style>

<div class="container-fluid mt-4 px-3 px-md-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="trainer-title">Planes de Entrenamiento</h2>
        <a href="@Url.Action("Create", "PlanEntrenamiento")" class="btn btn-success">
            <i class="fas fa-plus"></i> Crear nuevo plan
        </a>
    </div>


    <div class="table-responsive">
        <table id="tablaPlanes" class="table table-bordered table-hover align-middle">
            <thead>
                <tr>
                    <th>Atleta</th>
                    <th>Creador</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Objetivo</th>
                    <th class="text-center">Acciones</th>
                </tr>
                <tr class="filter-row">
                    <th><input type="text" placeholder="Filtrar por atleta" /></th>
                    <th><input type="text" placeholder="Filtrar por creador" /></th>
                    <th><input type="text" placeholder="AAAA-MM-DD" /></th>
                    <th>
                        <select id="filtro-estado">
                            <option value="">Todos</option>
                            <option value="Activo">Activo</option>
                            <option value="Inactivo">Inactivo</option>
                        </select>
                    </th>
                    <th><input type="text" placeholder="Filtrar por objetivo" id="filtro-objetivo" /></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var plan in Model)
                {
                    var puedeGestionar = currentUserRole == "Administrador" || 
                                         (currentUserRole == "Entrenador" && plan.IdCreador == currentUserId);

                    string resumenObjetivo = plan.Objetivo.Length > 30 ? plan.Objetivo.Substring(0, 30) + "..." : plan.Objetivo;

                    <tr data-estado="@(plan.Estado ? "Activo" : "Inactivo")">
                        <td>@plan.Atleta?.Nombre</td>
                        <td>@plan.Creador?.Nombre</td>
                        <td>@plan.FechaCreacion.ToString("yyyy-MM-dd")</td>
                        <td>
                            <span class="badge @(plan.Estado ? "bg-success" : "bg-danger")">
                                @(plan.Estado ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td title="@plan.Objetivo">@resumenObjetivo</td>
                        <td class="text-center">
                            <a href="@Url.Action("Details", "PlanEntrenamiento", new { id = plan.Id })"
                               class="btn btn-outline-primary btn-sm btn-action" title="Ver">
                                <i class="fas fa-eye"></i>
                            </a>

                            @if (puedeGestionar)
                            {
                                <a href="@Url.Action("Edit", "PlanEntrenamiento", new { id = plan.Id })"
                                   class="btn btn-outline-warning btn-sm btn-action" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <a href="@Url.Action("Clone", "PlanEntrenamiento", new { id = plan.Id })"
                                   class="btn btn-outline-info btn-sm btn-action" title="Clonar">
                                    <i class="fas fa-copy"></i>
                                </a>

                                <a href="@Url.Action("Delete", "PlanEntrenamiento", new { id = plan.Id })"
                                   class="btn btn-outline-danger btn-sm"
                                   onclick="return confirm('¿Seguro que deseas eliminar este plan?');" title="Eliminar">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#tablaPlanes').DataTable({
                orderCellsTop: true,
                fixedHeader: true,
                order: [[2, 'desc']],
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros por página",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ planes",
                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    },
                    zeroRecords: "No se encontraron resultados",
                    infoEmpty: "Mostrando 0 a 0 de 0 planes",
                    infoFiltered: "(filtrado de _MAX_ planes totales)"
                }
            });

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                var filtro = ($('#filtro-estado').val() || '').toLowerCase();
                if (!filtro) return true;
                var estadoRow = $($('#tablaPlanes').DataTable().row(dataIndex).node()).data('estado').toLowerCase();
                return estadoRow === filtro;
            });

            $('#filtro-estado').on('change', function () {
                table.draw();
            });

            $('#tablaPlanes thead tr.filter-row input').on('keyup change', function () {
                var colIndex = $(this).parent().index();
                if (colIndex === 4) return;
                table.column(colIndex).search(this.value).draw();
            });

            $('#filtro-objetivo').on('keyup change', function () {
                var valor = this.value.toLowerCase();
                table.rows().every(function () {
                    var celda = $(this.node()).find('td:eq(4)');
                    var tooltip = (celda.attr('title') || '').toLowerCase();
                    var visible = valor === '' || tooltip.includes(valor);
                    $(this.node()).toggle(visible);
                });
            });
        });
    </script>
}
