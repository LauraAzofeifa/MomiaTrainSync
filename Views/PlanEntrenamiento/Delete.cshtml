@model MomiaTrainSync.Models.PlanEntrenamiento

@{
    ViewData["Title"] = "Eliminar Plan";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-4">
    <h2>¿Eliminar este plan?</h2>

    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <p><strong>Atleta:</strong> @Model.Atleta?.Nombre</p>
            <p><strong>Creador:</strong> @Model.Creador?.Nombre</p>
            <p><strong>Creado el:</strong> @Model.FechaCreacion.ToString("yyyy-MM-dd")</p>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>
