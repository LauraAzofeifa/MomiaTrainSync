@model MomiaTrainSync.Models.PlanEntrenamiento

@{
    ViewData["Title"] = "Detalle del Plan";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-4">
    <h2>Detalle del Plan de Entrenamiento</h2>

    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <p><strong>Atleta:</strong> @Model.Atleta?.Nombre</p>
            <p><strong>Creador:</strong> @Model.Creador?.Nombre</p>
            <p><strong>Fecha de creación:</strong> @Model.FechaCreacion.ToString("yyyy-MM-dd")</p>
            <p><strong>Última modificación:</strong> @(Model.FechaModificacion?.ToString("yyyy-MM-dd") ?? "No modificado")</p>
            <p>
                <strong>Estado:</strong>
                <span class="badge @(Model.Estado ? "bg-success" : "bg-danger")">
                    @(Model.Estado ? "Activo" : "Inactivo")
                </span>
            </p>

            <p><strong>Objetivo del plan:</strong> @Model.Objetivo</p>

            <div class="mt-3">
                <strong>Detalle del plan:</strong>
                <div class="border rounded p-3 mt-2" style="white-space:pre-line;">
                    @Model.Detalle
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>
