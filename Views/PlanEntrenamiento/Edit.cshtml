@model MomiaTrainSync.Models.PlanEntrenamiento

@{
    ViewData["Title"] = "Editar Plan de Entrenamiento";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-4">
    <h2>Editar Plan de Entrenamiento</h2>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">Atleta</label>
            <input type="text" value="@Model.Atleta?.Nombre" class="form-control" disabled />
        </div>

        <div class="mb-3">
            <label asp-for="Objetivo" class="form-label">Objetivo</label>
            <input asp-for="Objetivo" class="form-control" maxlength="200" />
            <span asp-validation-for="Objetivo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Detalle" class="form-label">Detalle del plan</label>
            <textarea asp-for="Detalle" class="form-control" rows="6"></textarea>
            <span asp-validation-for="Detalle" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Estado" class="form-label">Estado</label>
            <select asp-for="Estado" class="form-select">
                <option value="true">Activo</option>
                <option value="false">Inactivo</option>
            </select>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-success">Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
