@{
    ViewData["Title"] = "Inicio";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
}

<div class="row mb-4">
    <div class="col">
        <h2 class="fw-bold">Dashboard</h2>
        <p class="text-muted">Bienvenido de vuelta, @User.Identity?.Name</p>
    </div>
</div>

<!-- 🟦 ADMIN -->
@if (rol == "Administrador")
{
    @await Html.PartialAsync("PartialViews/_DashboardAdmin")
}

<!-- 🟩 ENTRENADOR / ATLETA -->
@if (rol == "Entrenador" || rol == "Atleta")
{
    @await Html.PartialAsync("PartialViews/_DashboardUsuario")
}
