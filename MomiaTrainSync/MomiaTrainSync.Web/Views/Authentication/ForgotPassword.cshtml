@model RecoverPasswordViewModel

@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" />
}

<!-- Right side - Login Form -->
<div class="col-lg-6 d-flex align-items-center justify-content-center">
    <div class="auth-form-container">
        <div class="text-center mb-4">
            <h2 class="fw-bold mb-2">Recuperar Contraseña</h2>
            <p class="text-muted">Ingresa tu correo electrónico para continuar</p>
        </div>

        <form asp-action="ForgotPassword" method="post">
            @* Espacio de mensajes para ver errores *@
            <div asp-validation-summary="ModelOnly" class="alert alert-danger text-center"></div>

            @* Para mostrar todos es:
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div> *@

            <div class="mb-3">
                <label asp-for="Correo" class="form-label">Correo Electrónico</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-envelope"></i>
                    </span>
                    <input asp-for="Correo" type="email" class="form-control" placeholder="tu@email.com" />
                </div>
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">Recuperar Contraseña</button>

            <hr class="my-4">

            <div class="text-center">
                <p class="mb-0">¿Ya tienes cuenta? <a href="@Url.Action("Login", "Authentication")" class="text-decoration-none fw-semibold">Inicia Sesión</a></p>
            </div>
        </form>
    </div>
</div>