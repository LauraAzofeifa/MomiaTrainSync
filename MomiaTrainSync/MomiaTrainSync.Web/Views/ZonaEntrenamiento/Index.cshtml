@model ZonaEntrenameintoViewModel

@{
    ViewData["Title"] = "Zona de Entrenamiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="~/css/custom_style_tables.css" />
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold">
            <i class="bi bi-list-ul me-2"></i>Zonas de Entrenamiento
        </h3>
    </div>

    <div class="card shadow-sm">
        <div class="card-body table-responsive">

            <table id="zonaentrenamientosTable" class="my-table-custom table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Factor</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.ZonasEntrenamientos == null || !Model.ZonasEntrenamientos.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No hay zonas disponibles.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var e in Model.ZonasEntrenamientos)
                        {
                            <tr data-nombre="@e.Nombre"
                                data-descripcion="@e.Descripcion"
                                data-factor="@e.Factor">

                                <td>@e.Nombre</td>
                                <td>@e.Descripcion</td>
                                <td>@e.Factor</td>
                            </tr>
                        }
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="~/js/DataTable.js"></script>

