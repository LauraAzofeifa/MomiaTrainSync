@model IEnumerable<UsuarioDto>

@{
    ViewData["Title"] = "Administrar Atletas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/users.js"></script>
}

<div class="row mb-4">
    <div class="col">
        <h2 class="fw-bold">Gestión de mis Atletas</h2>
        <p class="text-muted">Administra y monitorea a todos mis Atletas</p>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addAthleteModal">
            <i class="bi bi-plus-circle me-2"></i>Agregar Atleta
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body table-responsive">
        <table id="usersTable" class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    @* <th>Deporte</th> *@
                    <th>Estado</th>
                    @* <th>Última Sesión</th> *@
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @{
                    if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="/placeholder.svg?height=32&width=32" alt="Atleta" class="rounded-circle me-2" width="32" height="32">
                                        <span>@user.Nombre</span>
                                    </div>
                                </td>
                                <td>@user.Correo</td>
                                <td>@user.Rol!.Nombre</td>
                                @* <td>Atletismo</td> *@
                                <td>
                                    <span class="badge @(user.Estado ? "bg-success" : "bg-warning")">
                                        @(user.Estado ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                @* <td>Hoy, 10:30 AM</td> *@
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" title="Ver perfil">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">No hay atletas disponibles.</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>


@section Modals {
    <!-- Add Athlete Modal -->
    <div class="modal fade" id="addAthleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Agregar Nuevo Atleta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="addAthleteForm">
                        <div class="mb-3">
                            <label for="athleteName" class="form-label">Nombre Completo</label>
                            <input type="text" class="form-control" id="athleteName" required>
                        </div>
                        <div class="mb-3">
                            <label for="athleteEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="athleteEmail" required>
                        </div>
                        <div class="mb-3">
                            <label for="athleteCoach" class="form-label">Entrenador</label>
                            <select class="form-select" id="athleteCoach" required>
                                <option value="">Seleccionar entrenador</option>
                                <option value="ana">Ana López</option>
                                <option value="pedro">Pedro Sánchez</option>
                                <option value="laura">Laura Díaz</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="athleteSport" class="form-label">Deporte</label>
                            <input type="text" class="form-control" id="athleteSport" required>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary">Guardar Atleta</button>
                </div>
            </div>
        </div>
    </div>
}