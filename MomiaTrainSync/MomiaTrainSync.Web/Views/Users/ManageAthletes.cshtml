@model IEnumerable<EntrenadorAtletaDto>

@{
    ViewData["Title"] = "Administrar Atletas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/users.js"></script>
    <link rel="stylesheet" href="~/css/custom_style_tables.css" />

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            $("#usersTable").DataTable();

            const tableBody = document.querySelector("#usersTable tbody");

            // Utilidad para asignar valores
            const fill = (id, value, isInput = false) => {
                const el = document.getElementById(id);
                if (!el) return;
                if (isInput) el.value = value;
                else el.textContent = value;
            };

            tableBody.addEventListener("click", (e) => {
                const btn = e.target.closest("button");
                if (!btn) return;

                const row = btn.closest("tr");
                const data = { ...row.dataset, estado: row.dataset.estado === "True" };

                if (btn.classList.contains("btn-view")) {
                    fill("viewAthleteName", data.nombre);
                    fill("viewAthleteEmail", data.correo);
                    fill("viewAthleteAssignDate", data.fecha);
                }

                if (btn.classList.contains("btn-edit")) {
                    fill("editId", data.id, true);
                    fill("editNombre", data.nombre, true);
                    fill("editCorreo", data.correo, true);
                    fill("editRol", data.rolid, true);
                    document.getElementById("editEstado").checked = data.estado;
                    fill("editFecha", data.fecha);
                }

                if (btn.classList.contains("btn-delete")) {
                    fill("deleteAthleteId", data.relation, true);
                    fill("deleteAthleteName", data.nombre);
                }
            });
        });
    </script>
}

<div class="row mb-4">
    <div class="col">
        <h2 class="fw-bold">Gestión de mis Atletas</h2>
        <p class="text-muted">Administra y monitorea a todos mis Atletas</p>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addAthleteModal">
            <i class="bi bi-plus-circle me-2"></i>Agregar Atleta
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body table-responsive">
        <table id="usersTable" class="my-table-custom table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Estado</th>
                    <th>Fecha Asignación</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var user in Model)
                    {
                        <tr data-id="@user.Atleta?.Id"
                            data-relation="@user.IdRelacion"
                            data-nombre="@($"{user.Atleta?.Nombre} {user.Atleta?.Apellido}")"
                            data-correo="@user.Atleta?.Correo"
                            data-estado="@user.Estado"
                            data-fecha="@user.FechaAsignacion.ToString("dd/MM/yyyy")">

                            <!-- Nombre + avatar -->
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="https://avatar.iran.liara.run/public/24?height=40&width=40"
                                         class="user-avatar me-3">

                                    <div>
                                        <div class="fw-semibold">@user.Atleta?.Nombre @user.Atleta?.Apellido</div>
                                        <div class="text-muted small">Atleta</div>
                                    </div>
                                </div>
                            </td>

                            <!-- Estado -->
                            <td>
                                <span class="badge @(user.Estado ? "badge-active" : "badge-inactive")">
                                    @(user.Estado ? "Activo" : "Inactivo")
                                </span>
                            </td>

                            <!-- Fecha Asignación -->
                            <td>@user.FechaAsignacion.ToString("dd/MM/yyyy")</td>

                            <!-- Acciones -->
                            <td class="text-center">

                                <!-- Ver -->
                                <button class="btn btn-sm btn-outline-primary table-action-btn btn-view"
                                        title="Ver"
                                        data-bs-toggle="modal"
                                        data-bs-target="#viewAthleteModal">
                                    <i class="bi bi-eye"></i>
                                </button>

                                <!-- Rutina (solo si activo) -->
                                @if (user.Estado)
                                {
                                    <a href="@Url.Action("Index", "Rutina", new { id = user.Atleta!.Id })"
                                    class="btn btn-sm btn-outline-success table-action-btn"
                                    title="Rutinas">
                                        <i class="bi bi-list-check"></i>
                                    </a>


                                    <!-- Desactivar relación -->
                                    <button class="btn btn-sm btn-outline-warning table-action-btn btn-delete"
                                            title="Desactivar Relación"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteAthleteModal">
                                        <i class="bi bi-slash-circle"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            <i class="bi bi-person-x fs-4 d-block mb-2"></i>
                            No tienes atletas asignados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


@section Modals {
    <!-- Add Athlete Modal -->
    <div class="modal fade" id="addAthleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Agregar Nuevo Atleta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Trainer" asp-action="AddAthlete" method="post">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="athleteCoach" class="form-label">Atletas</label>
                            <select asp-items="ViewBag.Athletes" class="form-select" name="IdAtleta"></select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar Atleta</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 🔹 Ver Usuario -->
    <div class="modal fade" id="viewAthleteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-person-badge me-2"></i>Detalles del Usuario</h5>
                    <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <img src="https://avatar.iran.liara.run/public/24" id="viewAvatar" class="rounded-circle border mb-3"
                         style="width:100px;height:100px;object-fit:cover;max-width:100%;">
                    <h5 id="viewAthleteName" class="fw-bold"></h5>
                    <span id="viewEstado" class="badge bg-success mb-3">Activo</span>
                    <ul class="list-group text-start">
                        @* <li class="list-group-item"><strong>ID:</strong> <span id="viewId"></span></li> *@
                        <li class="list-group-item"><strong>Correo:</strong> <span id="viewAthleteEmail"></span></li>
                        @* <li class="list-group-item"><strong>Rol:</strong> <span id="viewRol"></span></li> *@
                        <li class="list-group-item"><strong>Fecha Asignación:</strong> <span id="viewAthleteAssignDate"></span></li>
                    </ul>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Desactivar relación Modal -->
    <div class="modal fade" id="deleteAthleteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-warning">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title">
                        <i class="bi bi-slash-circle me-2"></i>Desactivar Relación
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <form asp-controller="Trainer" asp-action="DeleteAthlete" method="post">
                    <div class="modal-body text-center">
                        <p>
                            ¿Estás seguro de que deseas <strong>desactivar</strong> la relación con
                            <strong id="deleteAthleteName"></strong>?
                        </p>

                        <p class="text-muted small">
                            El atleta no será eliminado. Solo se desactivará la asignación.
                        </p>

                        <input type="hidden" id="deleteAthleteId" name="idRelacion" />
                    </div>

                    <div class="modal-footer justify-content-center">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-warning" id="confirmDeleteAthleteBtn">
                            Desactivar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

}