<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Página No Encontrada | FitTrack Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/styles.css">
    <link rel="stylesheet" href="~/css/style_error_page.css">
</head>
<body>
    <div class="error-page">
        <!-- Animated background -->
        <div class="error-animated-bg">
            <div class="floating-404-circle floating-404-circle-1"></div>
            <div class="floating-404-circle floating-404-circle-2"></div>
            <div class="floating-404-circle floating-404-circle-3"></div>
            <div class="floating-404-circle floating-404-circle-4"></div>
            <div class="floating-404-square floating-404-square-1"></div>
            <div class="floating-404-square floating-404-square-2"></div>
        </div>

        <!-- Error content -->
        <div class="error-content">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
