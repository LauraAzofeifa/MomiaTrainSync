@{
}

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Total Atletas</p>
                        <h3 class="fw-bold mb-0">156</h3>
                    </div>
                    <div class="stat-icon bg-primary-subtle">
                        <i class="bi bi-people text-primary"></i>
                    </div>
                </div>
                <div class="mt-2">
                    <span class="badge bg-success-subtle text-success">+12% este mes</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Entrenadores</p>
                        <h3 class="fw-bold mb-0">24</h3>
                    </div>
                    <div class="stat-icon bg-success-subtle">
                        <i class="bi bi-person-badge text-success"></i>
                    </div>
                </div>
                <div class="mt-2">
                    <span class="badge bg-success-subtle text-success">+3 nuevos</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Sesiones Hoy</p>
                        <h3 class="fw-bold mb-0">42</h3>
                    </div>
                    <div class="stat-icon bg-warning-subtle">
                        <i class="bi bi-calendar-check text-warning"></i>
                    </div>
                </div>
                <div class="mt-2">
                    <span class="badge bg-info-subtle text-info">8 en progreso</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Rutinas Activas</p>
                        <h3 class="fw-bold mb-0">89</h3>
                    </div>
                    <div class="stat-icon bg-danger-subtle">
                        <i class="bi bi-clipboard-data text-danger"></i>
                    </div>
                </div>
                <div class="mt-2">
                    <span class="badge bg-secondary-subtle text-secondary">15 pendientes</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-semibold">Actividad Reciente</h5>
            </div>
            <div class="card-body">
                <div class="activity-item">
                    <div class="activity-icon bg-success-subtle">
                        <i class="bi bi-check-circle text-success"></i>
                    </div>
                    <div class="activity-content">
                        <p class="mb-1"><strong>María González</strong> completó su rutina de fuerza</p>
                        <small class="text-muted">Hace 15 minutos</small>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="activity-icon bg-primary-subtle">
                        <i class="bi bi-plus-circle text-primary"></i>
                    </div>
                    <div class="activity-content">
                        <p class="mb-1"><strong>Coach Pedro</strong> asignó nueva rutina a 5 atletas</p>
                        <small class="text-muted">Hace 1 hora</small>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="activity-icon bg-warning-subtle">
                        <i class="bi bi-calendar-event text-warning"></i>
                    </div>
                    <div class="activity-content">
                        <p class="mb-1">Sesión de entrenamiento programada para mañana</p>
                        <small class="text-muted">Hace 2 horas</small>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="activity-icon bg-info-subtle">
                        <i class="bi bi-person-plus text-info"></i>
                    </div>
                    <div class="activity-content">
                        <p class="mb-1"><strong>Juan Martínez</strong> se registró como nuevo atleta</p>
                        <small class="text-muted">Hace 3 horas</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-semibold">Próximas Sesiones</h5>
            </div>
            <div class="card-body">
                <div class="session-item">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h6 class="mb-1">Entrenamiento de Velocidad</h6>
                            <small class="text-muted">Coach: Ana López</small>
                        </div>
                        <span class="badge bg-primary">Hoy</span>
                    </div>
                    <p class="mb-0 small"><i class="bi bi-clock me-1"></i>14:00 - 16:00</p>
                </div>

                <div class="session-item">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h6 class="mb-1">Fuerza y Resistencia</h6>
                            <small class="text-muted">Coach: Pedro Sánchez</small>
                        </div>
                        <span class="badge bg-secondary">Mañana</span>
                    </div>
                    <p class="mb-0 small"><i class="bi bi-clock me-1"></i>09:00 - 11:00</p>
                </div>

                <div class="session-item">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h6 class="mb-1">Técnica de Carrera</h6>
                            <small class="text-muted">Coach: Laura Díaz</small>
                        </div>
                        <span class="badge bg-secondary">Mañana</span>
                    </div>
                    <p class="mb-0 small"><i class="bi bi-clock me-1"></i>16:00 - 18:00</p>
                </div>
            </div>
        </div>
    </div>
</div>