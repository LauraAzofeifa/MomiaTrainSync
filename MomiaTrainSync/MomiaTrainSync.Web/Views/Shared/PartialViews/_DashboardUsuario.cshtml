<!-- Stats Cards -->
<div class="row g-4 mb-4">

    <div class="col-md-4">
        <div class="card stat-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Sesiones Realizadas</p>
                        <h3 class="fw-bold mb-0">18</h3>
                    </div>
                    <div class="stat-icon bg-primary-subtle">
                        <i class="bi bi-check2-circle text-primary"></i>
                    </div>
                </div>
                <div class="mt-2">
                    <span class="badge bg-success-subtle text-success">+2 esta semana</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card stat-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Rutinas Activas</p>
                        <h3 class="fw-bold mb-0">4</h3>
                    </div>
                    <div class="stat-icon bg-warning-subtle">
                        <i class="bi bi-clipboard-check text-warning"></i>
                    </div>
                </div>
                <div class="mt-2">
                    <span class="badge bg-secondary-subtle text-secondary">1 pendiente</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card stat-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">Próxima Sesión</p>
                        <h3 class="fw-bold mb-0">Mañana</h3>
                    </div>
                    <div class="stat-icon bg-info-subtle">
                        <i class="bi bi-calendar-event text-info"></i>
                    </div>
                </div>
                <div class="mt-2">
                    <span class="badge bg-primary-subtle text-primary">09:00 AM</span>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Actividad Reciente -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-semibold">Actividad Reciente</h5>
            </div>
            <div class="card-body">

                <div class="activity-item">
                    <div class="activity-icon bg-success-subtle">
                        <i class="bi bi-check-circle text-success"></i>
                    </div>
                    <div class="activity-content">
                        <p class="mb-1">Completaste la sesión de fuerza</p>
                        <small class="text-muted">Hace 20 minutos</small>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="activity-icon bg-primary-subtle">
                        <i class="bi bi-clipboard text-primary"></i>
                    </div>
                    <div class="activity-content">
                        <p class="mb-1">Nueva rutina asignada por tu entrenador</p>
                        <small class="text-muted">Hace 2 horas</small>
                    </div>
                </div>

                <div class="activity-item">
                    <div class="activity-icon bg-warning-subtle">
                        <i class="bi bi-calendar-check text-warning"></i>
                    </div>
                    <div class="activity-content">
                        <p class="mb-1">Sesión programada para mañana</p>
                        <small class="text-muted">Hace 5 horas</small>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Próximas sesiones -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-semibold">Mis Próximas Sesiones</h5>
            </div>
            <div class="card-body">

                <div class="session-item">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h6 class="mb-1">Fuerza - Tren Superior</h6>
                            <small class="text-muted">Coach: Pedro Sánchez</small>
                        </div>
                        <span class="badge bg-primary">Mañana</span>
                    </div>
                    <p class="mb-0 small"><i class="bi bi-clock me-1"></i>09:00 - 10:30</p>
                </div>

                <div class="session-item">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h6 class="mb-1">Cardio - Resistencia</h6>
                            <small class="text-muted">Coach: Ana López</small>
                        </div>
                        <span class="badge bg-secondary">En 2 días</span>
                    </div>
                    <p class="mb-0 small"><i class="bi bi-clock me-1"></i>14:00 - 15:00</p>
                </div>

            </div>
        </div>
    </div>
</div>
