@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Authentication
@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MomiaTrainSync</title>

    <!-- 🔹 Estilos -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MomiaTrainSync.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />

    @RenderSection("Styles",required:false)
</head>
<body id="top" class="d-flex flex-column min-vh-100">

    <!-- === Header === -->
    <header class="sticky-top shadow-sm bg-white">
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" href="index.html">
                    <i class="fas fa-dumbbell me-2"></i> MomiaTrainSync
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                @* <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav gap-2">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" href="index.html">
                                <i class="fas fa-home me-1"></i>Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" href="login.html">
                                <i class="fas fa-sign-in-alt me-1"></i> Iniciar Sesión
                            </a>
                        </li>
                    </ul>
                </div> *@
            </div>
        </nav>
    </header>

    <!-- MAIN -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="mt-auto pt-4">
        <div class="container text-center text-md-start">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5 class="fw-bold">MomiaTrainSync</h5>
                    <p>Tu plataforma para mejorar el rendimiento físico y la conexión entre entrenadores y atletas.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6 class="fw-bold">Enlaces útiles</h6>
                    <ul class="list-unstyled">
                        <li><a href="index.html"><i class="fas fa-angle-right me-1"></i> Inicio</a></li>
                        <li><a href="#"><i class="fas fa-angle-right me-1"></i> Sobre Nosotros</a></li>
                        <li><a href="#"><i class="fas fa-angle-right me-1"></i> Contacto</a></li>
                        <li><a href="#"><i class="fas fa-angle-right me-1"></i> Términos y Condiciones</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-3 text-center text-md-start">
                    <h6 class="fw-bold">Síguenos</h6>
                    <div class="footer-social mt-2">
                        <a href="#"><i class="fab fa-facebook"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>
            </div>
            <hr class="border-secondary">
            <div class="text-center py-2">
                <small>&copy; 2025 MomiaTrainSync. Todos los derechos reservados.</small>
            </div>
        </div>
    </footer>

    <!-- === Botón ScrollTop === -->
    @* <button id="scrollTopBtn" onclick="window.scrollTo({ top: 0, behavior: 'smooth' });" title="Subir al inicio">
        <i class="fas fa-arrow-up"></i>
    </button> *@

    <!-- === Scripts === -->
    <script src="https://kit.fontawesome.com/1c3c17639b.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
