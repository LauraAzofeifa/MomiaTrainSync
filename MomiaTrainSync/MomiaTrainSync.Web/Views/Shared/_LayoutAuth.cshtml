@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Authentication
@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MomiaTrainSync</title>

    <!-- 🔹 Estilos -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    @RenderSection("Styles",required:false)
</head>
<body class="auth-page">

    <div class="container-fluid h-100">
        <div class="row h-100">
            <!-- Left side - Image/Branding -->
            <div class="col-lg-6 d-none d-lg-flex auth-hero">
                <div class="auth-hero-content">
                    <h1 class="display-4 fw-bold text-white mb-3">MomiaTrain</h1>
                    <p class="lead text-white-50">Sistema de gestión de entrenamiento para atletas y entrenadores</p>
                </div>
            </div>
            @RenderBody()
        </div>

        <!-- Added footer for auth pages -->
        <footer class="auth-footer">
            <div class="container">
                <div class="row py-3">
                    <div class="col-12 text-center">
                        <p class="mb-0 text-muted small">&copy; @DateTime.Now.Year MomiaTrain Admin. Todos los derechos reservados.</p>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @* <script src="~/js/auth.js"></script> *@

    @RenderSection("Scripts", required: false)
</body>
</html>
