@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Authentication
@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MomiaTrainSync</title>

    <!-- 🔹 Estilos -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    @RenderSection("Styles",required:false)
</head>
<body class="auth-page">

    <div class="container-fluid min-vh-100 d-flex flex-column">

        <div class="row flex-grow-1">
            <!-- Left side - Image/Branding -->
            <div class="col-lg-6 d-none d-lg-flex auth-hero">
                <div class="animated-bg">
                    <div class="floating-circle floating-circle-1 floating-animation"></div>
                    <div class="floating-circle floating-circle-2 floating-animation"></div>
                    <div class="floating-circle floating-circle-3 floating-animation"></div>
                </div>
                <div class="auth-hero-content">
                    <h1 class="display-4 fw-bold text-white mb-3">MomiaTrain</h1>
                    <p class="lead text-white-50">
                        Sistema de gestión de entrenamiento para atletas y entrenadores
                    </p>
                </div>
            </div>

            @RenderBody()
        </div>

        <!-- Footer -->
        <footer class="auth-footer">
            <div class="container">
                <div class="row py-3">
                    <div class="col-12 text-center">
                        <p class="mb-0 text-muted small">
                            &copy; @DateTime.Now.Year MomiaTrain Admin. Todos los derechos reservados.
                        </p>
                    </div>
                </div>
            </div>
        </footer>

    </div>

    <!-- Toast container -->
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1100">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="toast align-items-center text-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        @TempData["SuccessMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="toast align-items-center text-danger border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        @TempData["ErrorMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <!-- Script para inicializar los toasts -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toastElList = [].slice.call(document.querySelectorAll('.toast'));
            toastElList.map(function (toastEl) {
                const t = new bootstrap.Toast(toastEl, { delay: 3500 });
                t.show();
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @* <script src="~/js/auth.js"></script> *@

    @RenderSection("Scripts", required: false)
</body>
</html>
