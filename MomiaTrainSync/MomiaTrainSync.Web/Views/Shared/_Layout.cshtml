@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Authentication
@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MomiaTrainSync</title>

    <!-- 🔹 Estilos -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site_two.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- HEADER -->
    <header class="header">
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
            <div class="container-fluid">
                <button id="toggleSidebar" class="btn btn-outline-light me-2 d-md-none">
                    <i class="fas fa-bars"></i>
                </button>
                <a class="navbar-brand d-flex align-items-center" href="#">
                    <i class="fas fa-dumbbell me-2"></i> MomiaTrainSync
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav gap-2">
                        <!-- Usuario logueado con dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="https://avatar.iran.liara.run/public/2" alt="Avatar" class="rounded-circle me-2" width="32" height="32">
                                <span class="fw-semibold">@(User.Identity?.Name ?? "Nombre Usuario")</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i>Perfil</a></li>
                                <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i>Configuración</a></li>
                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <form method="post" asp-controller="Authentication" asp-action="Logout">
                                        <button type="submit" class="dropdown-item">
                                            <i class="fas fa-sign-out-alt me-2"></i> Cerrar Sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>


    <!-- GRID LAYOUT -->
    <div class="grid-layout">
        <!-- SIDEBAR -->
        <nav class="sidebar" id="sidebarMenu">

            <h5 class="mb-4 d-flex align-items-center">
                <i class="fas fa-dumbbell me-2"></i> MomiaTrainSync
            </h5>

            <ul class="nav nav-pills flex-column mb-auto" id="sidebarMenu">

                @if (User.IsInRole("Administrador"))
                {
                    <li class="nav-item">
                        <a href="#" class="nav-link text-white">
                            <i class="fas fa-home me-2"></i>Inicio
                        </a>
                    </li>

                    <!-- 🔽 Dropdown de Administración -->
                    <li class="nav-item dropdown">
                        <a class="nav-link text-white d-flex justify-content-between align-items-center" href="#"
                           data-bs-toggle="collapse" data-bs-target="#submenuAdmin" aria-expanded="false">
                            <span><i class="fas fa-user-shield me-2"></i>Administración</span>
                            <i class="fas fa-chevron-down small"></i>
                        </a>
                        <ul class="collapse list-unstyled ps-4" id="submenuAdmin" data-bs-parent="#sidebarMenu">
                            <li><a asp-controller="Admin" asp-action="Users" class="nav-link text-white-50"><i class="fas fa-users me-2"></i>Usuarios</a></li>
                            <li><a href="#" class="nav-link text-white-50"><i class="fas fa-key me-2"></i>Permisos</a></li>
                            <li><a href="#" class="nav-link text-white-50"><i class="fas fa-chart-bar me-2"></i>Métricas</a></li>
                        </ul>
                    </li>

                    <li>
                        <a href="#" class="nav-link text-white">
                            <i class="fas fa-tachometer-alt me-2"></i>Dashboard Admin
                        </a>
                    </li>
                }

                @if (User.IsInRole("Entrenador"))
                {
                    <li class="nav-item">
                        <a href="#" class="nav-link text-white">
                            <i class="fas fa-home me-2"></i>Inicio
                        </a>
                    </li>

                    <li>
                        <a href="#" class="nav-link text-white">
                            <i class="fas fa-chart-line me-2"></i>Dashboard Entrenador
                        </a>
                    </li>

                    <!-- 🔽 Dropdown de Entrenador -->
                    <li class="nav-item dropdown">
                        <a class="nav-link text-white d-flex justify-content-between align-items-center" href="#"
                           data-bs-toggle="collapse" data-bs-target="#submenuTrainer" aria-expanded="false">
                            <span><i class="fas fa-dumbbell me-2"></i>Entrenador</span>
                            <i class="fas fa-chevron-down small"></i>
                        </a>
                        <ul class="collapse list-unstyled ps-4" id="submenuTrainer" data-bs-parent="#sidebarMenu">
                            <li><a href="#" class="nav-link text-white-50"><i class="fas fa-tasks me-2"></i>Planes</a></li>
                            <li><a href="#" class="nav-link text-white-50"><i class="fas fa-users me-2"></i>Mis Atletas</a></li>
                            <li><a href="#" class="nav-link text-white-50"><i class="fas fa-calendar-alt me-2"></i>Calendario</a></li>
                        </ul>
                    </li>
                }

                @if (User.IsInRole("Atleta"))
                {
                    <li class="nav-item">
                        <a href="#" class="nav-link text-white">
                            <i class="fas fa-home me-2"></i>Inicio
                        </a>
                    </li>

                    <li>
                        <a href="#" class="nav-link text-white">
                            <i class="fas fa-dumbbell me-2"></i>Entrenamientos
                        </a>
                    </li>
                    <!-- 🔽 Dropdown de Progreso -->
                    @* <li class="nav-item dropdown">
                        <a class="nav-link text-white d-flex justify-content-between align-items-center" href="#"
                           data-bs-toggle="collapse" data-bs-target="#submenuProgreso" aria-expanded="false">
                            <span><i class="fas fa-chart-line me-2"></i>Progreso</span>
                            <i class="fas fa-chevron-down small"></i>
                        </a>
                        <ul class="collapse list-unstyled ps-4" id="submenuProgreso" data-bs-parent="#sidebarMenu">
                            <li><a href="#" class="nav-link text-white-50"><i class="fas fa-chart-pie me-2"></i>Resumen</a></li>
                            <li><a href="#" class="nav-link text-white-50"><i class="fas fa-history me-2"></i>Historial</a></li>
                            <li><a href="#" class="nav-link text-white-50"><i class="fas fa-balance-scale me-2"></i>Comparativas</a></li>
                        </ul>
                    </li> *@
                }

                <li>
                    <a href="#" class="nav-link text-white">
                        <i class="fas fa-cog me-2"></i>Configuración
                    </a>
                </li>
            </ul>
        </nav>


        <!-- MAIN -->
        <main class="main-content">
            @RenderBody()

            <!-- FOOTER -->
            <footer class=" footer mt-auto pt-4">
                <div class="container text-center text-md-start">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <h5 class="fw-bold">MomiaTrainSync</h5>
                            <p>Tu plataforma para mejorar el rendimiento físico y la conexión entre entrenadores y atletas.</p>
                        </div>
                        <div class="col-md-4 mb-3">
                            <h6 class="fw-bold">Enlaces útiles</h6>
                            <ul class="list-unstyled">
                                <li><a href="index.html"><i class="fas fa-angle-right me-1"></i> Inicio</a></li>
                                <li><a href="#"><i class="fas fa-angle-right me-1"></i> Sobre Nosotros</a></li>
                                <li><a href="#"><i class="fas fa-angle-right me-1"></i> Contacto</a></li>
                                <li><a href="#"><i class="fas fa-angle-right me-1"></i> Términos y Condiciones</a></li>
                            </ul>
                        </div>
                        <div class="col-md-4 mb-3 text-center text-md-start">
                            <h6 class="fw-bold">Síguenos</h6>
                            <div class="footer-social mt-2">
                                <a href="#"><i class="fab fa-facebook"></i></a>
                                <a href="#"><i class="fab fa-instagram"></i></a>
                                <a href="#"><i class="fab fa-twitter"></i></a>
                                <a href="#"><i class="fab fa-youtube"></i></a>
                            </div>
                        </div>
                    </div>
                    <hr class="border-secondary">
                    <div class="text-center py-2">
                        <small>&copy; 2025 MomiaTrainSync. Todos los derechos reservados.</small>
                    </div>
                </div>
            </footer>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("toggleSidebar");
            const sidebar = document.getElementById("sidebarMenu");
            const gridLayout = document.querySelector(".grid-layout");

            toggleBtn.addEventListener("click", () => {
                sidebar.classList.toggle("show");
                gridLayout.classList.toggle("sidebar-open");
                document.body.classList.toggle("sidebar-active");
            });
        });
    </script>
</body>
</html>
