<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - MomiaTrainSync Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/css/site_two.css">

</head>
<body>
    <div class="wrapper">

        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-header">
                <h3 class="fw-bold">MomiaTrain</h3>
            </div>

            <ul class="list-unstyled components">
                @if (User.IsInRole("Administrador"))    
                {
                    <li class="active">
                        <a asp-controller="Home" asp-action="Index">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="athletes.html">
                            <i class="bi bi-people"></i>
                            <span>Atletas</span>
                        </a>
                    </li>
                    <li>
                        <a href="schedule.html">
                            <i class="bi bi-calendar-event"></i>
                            <span>Calendario</span>
                        </a>
                    </li>
                    <li>
                        <a href="#routinesSubmenu" data-bs-toggle="collapse" aria-expanded="false">
                            <i class="bi bi-shield"></i>
                            <span>Administración</span>
                            <i class="bi bi-chevron-down ms-auto"></i>
                        </a>
                        <ul class="collapse list-unstyled" id="routinesSubmenu">
                            <li><a asp-controller="Admin" asp-action="Users"><i class="bi bi-people"></i>Usuarios</a></li>
                            <li><a asp-controller="Admin" asp-action="Permises"><i class="bi bi-key"></i>Permisos</a></li>
                            <li><a asp-controller="Admin" asp-action="Metrics"><i class="bi bi-people"></i>Métricas</a></li>
                        </ul>
                    </li>
                    <li>
                        <a href="#">
                            <i class="bi bi-graph-up"></i>
                            <span>Reportes</span>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <i class="bi bi-gear"></i>
                            <span>Configuración</span>
                        </a>
                    </li>
                }

                @if (User.IsInRole("Entrenador"))
                {
                    <li class="active">
                        <a asp-controller="Home" asp-action="Index">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="athletes.html">
                            <i class="bi bi-people"></i>
                            <span>Atletas</span>
                        </a>
                    </li>
                    <li>
                        <a href="schedule.html">
                            <i class="bi bi-calendar-event"></i>
                            <span>Calendario</span>
                        </a>
                    </li>
                    <li>
                        <a href="#routinesSubmenu" data-bs-toggle="collapse" aria-expanded="false">
                            <i class="bi bi-clipboard-check"></i>
                            <span>Rutinas</span>
                            <i class="bi bi-chevron-down ms-auto"></i>
                        </a>
                        <ul class="collapse list-unstyled" id="routinesSubmenu">
                            <li><a href="#">Ver Rutinas</a></li>
                            <li><a href="#">Crear Rutina</a></li>
                            <li><a href="#">Plantillas</a></li>
                        </ul>
                    </li>
                    <li>
                        <a href="#">
                            <i class="bi bi-graph-up"></i>
                            <span>Reportes</span>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <i class="bi bi-gear"></i>
                            <span>Configuración</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>

        <!-- Page Content -->
        <div id="content">
            <!-- Top Navigation -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
                <div class="container-fluid">
                    <button type="button" id="sidebarCollapse" class="btn btn-light">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="ms-auto d-flex align-items-center">
                        <!-- Notifications -->
                        <div class="dropdown me-3">
                            <button class="btn btn-light position-relative" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-bell"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    3
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><h6 class="dropdown-header">Notificaciones</h6></li>
                                <li><a class="dropdown-item" href="#">Nueva rutina asignada</a></li>
                                <li><a class="dropdown-item" href="#">Atleta completó entrenamiento</a></li>
                                <li><a class="dropdown-item" href="#">Recordatorio de sesión</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-center" href="#">Ver todas</a></li>
                            </ul>
                        </div>

                        <!-- User Dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-light d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                                <img src="/placeholder.svg?height=32&width=32" alt="User" class="rounded-circle me-2" width="32" height="32">
                                <span class="me-2">@(User.Identity?.Name ?? "Nombre Usuario")</span>
                                <i class="bi bi-chevron-down"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="@Url.Action("MiPerfil","Profile")"><i class="bi bi-person me-2"></i>Mi Perfil</a></li>
                                <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Configuración</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-controller="Authentication" asp-action="Logout">
                                        <button type="submit" class="dropdown-item">
                                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <div class="container-fluid p-3">
                @RenderBody()
            </div>

            <!-- Footer Section -->
            <footer class="footer bg-white border-top mt-auto">
                <div class="container-fluid py-4">
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-0 text-muted">&copy; @DateTime.Now.Year MomiaTrain Admin. Todos los derechos reservados.</p>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <a href="#" class="text-muted text-decoration-none me-3">Términos de Servicio</a>
                            <a href="#" class="text-muted text-decoration-none me-3">Privacidad</a>
                            <a href="#" class="text-muted text-decoration-none me-3">Soporte</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Toast container -->
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1100">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="toast align-items-center text-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        @TempData["SuccessMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="toast align-items-center text-danger border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        @TempData["ErrorMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <!-- Script para inicializar los toasts -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toastElList = [].slice.call(document.querySelectorAll('.toast'));
            toastElList.map(function (toastEl) {
                const t = new bootstrap.Toast(toastEl, { delay: 3500 });
                t.show();
            });
        });
    </script>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js"></script>
    @RenderSection("Scripts", required:false);
</body>
</html>
